{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@assets": ["./assets"],
      "@screens": ["./screens/*"],
      "@theme/*": ["./theme/*"],
      "@modules": ["./modules"],
      "@config": ["./config"],
      "@utils": ["./utils"],
      "@images": ["./assets/images"]
    }
  }
}
